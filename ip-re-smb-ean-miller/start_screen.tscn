horizontal_alignment = 1

[node name="Plot" type="Label" parent="."]
offset_left = 198.0
offset_top = 99.0
offset_right = 949.0
offset_bottom = 122.0
text = "You are Soot, a mimic made from ash and dust, and you seek to achieve what you were made for..."

[node name="Plot2" type="Label" parent="."]
offset_left = 246.0
offset_top = 175.0
offset_right = 937.0
offset_bottom = 198.0
text = "To copy a powerful creature, or perhaps take their place and dispose of them if you must."

[node name="Plot3" type="Label" parent="."]
offset_left = 114.0
offset_top = 249.0
offset_right = 1060.0
offset_bottom = 272.0
text = "Currently you are just yourself, but you've detected trace amounts of particularly powerful magic scattered around the area..."

[node name="Plot4" type="Label" parent="."]
offset_left = 9.0
offset_top = 313.0
offset_right = 1135.0
offset_bottom = 336.0
text = "It's the magic of an AshenFang, a famous demihuman race both strong and feral in equal measure, though you're not sure what one is doing here."

[node name="Plot5" type="Label" parent="."]
offset_left = 43.0
offset_top = 392.0
offset_right = 1096.0
offset_bottom = 415.0
text = "It doesn't matter to you though. All that matters is that there might be enough DNA left behind for you to make rough copy of their form..."

[node name="Plot6" type="Label" parent="."]
offset_left = 58.0
offset_top = 445.0
offset_right = 1111.0
offset_bottom = 468.0
text = "After that... well... maybe then you can pay them a visit and \"borrow\" the rest of what you need to take on a completed AshenFang form."

[connection signal="pressed" from="StartButton" to="." method="_on_start_button_pressed"]
